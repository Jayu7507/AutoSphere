@model AutoSphere.Models.Coupon
@{
    ViewData["Title"] = "Edit Coupon";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-card p-4">
            <h4 class="fw-bold mb-4 border-bottom border-secondary pb-2">Modify Discount Coupon</h4>
            
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Coupon Code</label>
                    <input asp-for="Code" class="form-control bg-dark text-white border-secondary text-uppercase" placeholder="e.g. SUMMER25" required />
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Discount (%)</label>
                        <input asp-for="DiscountPercentage" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Max Discount (₹)</label>
                        <input asp-for="MaxDiscountAmount" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">Expiry Date</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control bg-dark text-white border-secondary" required />
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label class="form-check-label text-light small">Coupon is Active (Redeemable by users)</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning flex-grow-1 text-dark fw-bold">Update Coupon</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
