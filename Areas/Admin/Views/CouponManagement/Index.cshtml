@model IEnumerable<AutoSphere.Models.Coupon>
@{
    ViewData["Title"] = "Coupon Management";
}

<div class="glass-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold m-0">Discount Coupons</h4>
        <a asp-action="Create" class="btn btn-warning btn-sm"><i class="fas fa-plus me-1 text-dark"></i> Create Coupon</a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle border-secondary">
            <thead>
                <tr>
                    <th class="border-secondary text-muted small">Coupon Code</th>
                    <th class="border-secondary text-muted small text-center">Discount %</th>
                    <th class="border-secondary text-muted small text-end">Max Cap</th>
                    <th class="border-secondary text-muted small text-center">Expiry</th>
                    <th class="border-secondary text-muted small text-center">Status</th>
                    <th class="border-secondary text-muted small text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coupon in Model)
                {
                    <tr>
                        <td class="border-secondary py-3">
                            <span class="text-warning fw-bold font-monospace fs-5">@coupon.Code</span>
                        </td>
                        <td class="border-secondary text-center">@coupon.DiscountPercentage%</td>
                        <td class="border-secondary text-end fw-bold">₹@coupon.MaxDiscountAmount.ToString("N2")</td>
                        <td class="border-secondary text-center small text-muted">
                            @coupon.ExpiryDate.ToString("dd MMM yyyy")
                            @if(coupon.ExpiryDate < DateTime.Now)
                            {
                                <div class="text-danger x-small">Expired</div>
                            }
                        </td>
                        <td class="border-secondary text-center">
                            @if(coupon.IsActive && coupon.ExpiryDate > DateTime.Now)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="border-secondary text-end">
                            <a asp-action="Edit" asp-route-id="@coupon.Id" class="btn btn-link text-primary p-0 me-3"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@coupon.Id" method="post" style="display:inline;" onsubmit="return confirm('Delete this coupon?');">
                                <button type="submit" class="btn btn-link text-danger p-0"><i class="fas fa-trash-alt"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if(!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted small italic">No coupons found. Create your first one!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
