@model AutoSphere.Models.Coupon
@{
    ViewData["Title"] = "Create Coupon";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-card p-4">
            <h4 class="fw-bold mb-4">New Promo Code</h4>
            
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Coupon Code</label>
                    <input asp-for="Code" class="form-control bg-dark text-white border-secondary text-uppercase" placeholder="e.g. SAVE20, WELCOME50" required />
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Discount Percentage (%)</label>
                        <input asp-for="DiscountPercentage" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Max Discount Cap (₹)</label>
                        <input asp-for="MaxDiscountAmount" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">Expiry Date</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control bg-dark text-white border-secondary" required value="@DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd")" />
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" checked />
                    <label class="form-check-label text-light small">Coupon is Active</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning flex-grow-1 text-dark fw-bold">Create Coupon</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
