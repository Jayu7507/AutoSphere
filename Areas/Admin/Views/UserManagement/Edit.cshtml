@model AutoSphere.Models.User
@{
    ViewData["Title"] = "Update User Role";
    Layout = "_AdminLayout";
}

<div class="glass-card p-4 mx-auto" style="max-width: 500px;">
    <h4 class="fw-bold mb-4 text-center">Promote / Demote User</h4>
    
    <div class="user-info bg-dark p-3 rounded-3 mb-4 border border-secondary" style="background-color: rgba(26, 31, 44, 0.5) !important;">
        <div class="small text-muted text-uppercase fw-bold">User Information</div>
        <div class="fs-5 fw-bold text-light mt-1">@Model.FullName</div>
        <div class="small text-muted">@Model.Email</div>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        
        <div class="mb-4">
            <label class="form-label">System Role</label>
            <select name="RoleId" class="form-select bg-dark border-secondary">
                @foreach (var role in (IEnumerable<AutoSphere.Models.Role>)ViewBag.Roles)
                {
                    @if (role.Name != "Admin") // Prevent creating new admins here for safety
                    {
                        <!option value="@role.Id" @(Model.RoleId == role.Id ? "selected" : "")>@role.Name</!option>
                    }
                }
            </select>
            <div class="form-text small opacity-50">Changing to 'Staff' will allow this user to be added to the Workshop roster.</div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning flex-grow-1 text-dark fw-bold">Save Change</button>
            <a asp-action="Index" class="btn btn-outline-light px-4">Cancel</a>
        </div>
    </form>
</div>
