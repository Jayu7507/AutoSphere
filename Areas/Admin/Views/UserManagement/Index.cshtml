@model IEnumerable<AutoSphere.Models.User>
@{
    ViewData["Title"] = "Manage Users & Roles";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0"><i class="fas fa-users me-2 text-primary"></i> User Directory</h3>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success bg-dark border-success text-success">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
    </div>
}

<div class="glass-card table-responsive p-0 overflow-hidden">
    <table class="table table-dark table-hover mb-0 align-middle">
        <thead>
            <tr class="text-muted text-uppercase" style="background-color: rgba(0,0,0,0.2); font-size: 0.8rem;">
                <th class="py-3 px-4">Name</th>
                <th class="py-3 px-4">Contact</th>
                <th class="py-3 px-4">Role</th>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4 text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if(Model != null && Model.Any())
            {
                foreach(var user in Model)
                {
                    <tr>
                        <td class="py-3 px-4 fw-bold">@user.FullName</td>
                        <td class="py-3 px-4">
                            <div><i class="fas fa-envelope text-muted me-1"></i> @user.Email</div>
                            <small class="text-muted"><i class="fas fa-phone text-muted me-1"></i> @user.Phone</small>
                        </td>
                        <td class="py-3 px-4">
                            @if(user.Role?.Name == "Admin"){ <span class="badge bg-danger">Admin</span> }
                            else if(user.Role?.Name == "Staff"){ <span class="badge bg-warning text-dark">Staff</span> }
                            else { <span class="badge bg-secondary">User</span> }
                        </td>
                        <td class="py-3 px-4">
                            @if(user.IsEmailVerified) {
                                <span class="text-success small fw-bold"><i class="fas fa-check-circle me-1"></i> Verified</span>
                            } else {
                                <span class="text-warning small fw-bold"><i class="fas fa-exclamation-circle me-1"></i> Pending</span>
                            }
                        </td>
                        <td class="py-3 px-4 text-center">
                            @if(user.Role?.Name != "Admin")
                            {
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info" title="Edit Role"><i class="fas fa-edit"></i></a>
                                    <form asp-action="Delete" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Confirm deletion of (@user.FullName)?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-5 text-muted">No users found in system.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
