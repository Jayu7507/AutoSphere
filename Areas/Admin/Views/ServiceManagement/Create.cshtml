@model AutoSphere.Models.Service
@{
    ViewData["Title"] = "Create Service";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i> Back to Services</a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="glass-card p-4 border-top border-4 border-primary">
            <h4 class="fw-bold mb-4">Add New Service</h4>
            
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label text-muted fw-bold">Service Name</label>
                    <input asp-for="Name" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Premium Engine Wash" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <label asp-for="Price" class="form-label text-muted fw-bold">Price (₹)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control bg-dark text-white border-secondary text-warning fw-bold" placeholder="0.00" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-muted fw-bold">Service Description</label>
                    <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="4" placeholder="Describe the service steps and benefits..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="IncludedFeatures" class="form-label text-muted fw-bold">Features Included (Comma separated)</label>
                    <input asp-for="IncludedFeatures" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Oil change, Filter replacement, Free Wash" />
                </div>

                <div class="mb-4 p-3 rounded" style="background: rgba(0,255,255,0.05); border: 1px dashed rgba(0,255,255,0.3);">
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" asp-for="IsDoorstepAvailable" id="doorstepSwitch">
                        <label class="form-check-label text-light fw-bold" for="doorstepSwitch">Doorstep Service Available</label>
                    </div>
                    <small class="text-muted d-block mt-1">Enable this if the service can be performed at the customer's home (e.g. Oil Change, Inspection).</small>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-bold">Image 1 (Main)</label>
                        <input type="file" name="image1" class="form-control bg-dark text-white border-secondary form-control-sm" accept="image/*" />
                        <input type="hidden" asp-for="ImageUrl1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-bold">Image 2</label>
                        <input type="file" name="image2" class="form-control bg-dark text-white border-secondary form-control-sm" accept="image/*" />
                        <input type="hidden" asp-for="ImageUrl2" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-bold">Image 3</label>
                        <input type="file" name="image3" class="form-control bg-dark text-white border-secondary form-control-sm" accept="image/*" />
                        <input type="hidden" asp-for="ImageUrl3" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning flex-grow-1 text-dark fw-bold">Save Service <i class="fas fa-save ms-2"></i></button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
