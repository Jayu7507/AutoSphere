@model IEnumerable<AutoSphere.Models.Service>
@{
    ViewData["Title"] = "Manage Services";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0"><i class="fas fa-tools me-2 text-primary"></i> Service Dictionary</h3>
    <a asp-action="Create" class="btn btn-warning btn-sm px-3"><i class="fas fa-plus me-1 text-dark"></i> Add New Service</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success bg-dark border-success text-success">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
    </div>
}

<div class="glass-card table-responsive p-0 overflow-hidden">
    <table class="table table-dark table-hover mb-0 align-middle">
        <thead>
            <tr class="text-muted" style="background-color: rgba(0,0,0,0.2);">
                <th class="py-3 px-4" style="width: 100px;">Preview</th>
                <th class="py-3 px-4">Service Name</th>
                <th class="py-3 px-4">Price (₹)</th>
                <th class="py-3 px-4 text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if(Model != null && Model.Any())
            {
                foreach(var item in Model)
                {
                    <tr>
                        <td class="py-3 px-4">
                            @if (!string.IsNullOrEmpty(item.ImageUrl1))
                            {
                                <img src="@item.ImageUrl1" 
                                     style="width: 50px; height: 35px; object-fit: cover; border-radius: 4px;" 
                                     alt="Preview" 
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div style="width: 50px; height: 35px; background: rgba(255,255,255,0.05); border-radius: 4px; display: none; align-items: center; justify-content: center;">
                                    <i class="fas fa-image text-muted x-small"></i>
                                </div>
                            }
                            else
                            {
                                <div style="width: 50px; height: 35px; background: rgba(255,255,255,0.05); border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-image text-muted x-small"></i>
                                </div>
                            }
                        </td>
                        <td class="py-3 px-4 fw-bold">@item.Name</td>
                        <td class="py-3 px-4 text-warning fw-bold">₹@item.Price.ToString("0.00")</td>
                        <td class="py-3 px-4 text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light me-1"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Delete this service?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center py-5 text-muted">No services found. Start by adding one.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
