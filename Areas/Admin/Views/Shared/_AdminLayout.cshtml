<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel | AutoSphere</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --primary: #0F52BA;
            --secondary: #FF6B00;
            --dark-bg: #0B0F19;
            --light-bg: #1A1F2C;
            --text-light: #F8F9FA;
            --slate-grey: #2E3440;
            --slate-grey-light: #3B4252;
            --text-muted: #94A3B8;

            /* Bootstrap Global Overrides for Dark Theme */
            --bs-body-color: var(--text-light);
            --bs-body-bg: var(--dark-bg);
            --bs-secondary-color: var(--text-muted);
            --bs-tertiary-color: var(--text-muted);
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-light);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        .sidebar {
            height: 100vh;
            background: rgba(26, 31, 44, 0.95);
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            position: fixed;
            top: 0;
            left: 0;
            width: 260px;
            padding-top: 20px;
            z-index: 1000;
        }

        .sidebar-brand {
            font-weight: 800;
            color: var(--text-light);
            font-size: 1.5rem;
            text-align: center;
            margin-bottom: 30px;
            letter-spacing: 1px;
            display: block;
            text-decoration: none;
        }
        .sidebar-brand span { color: var(--secondary); }

        .nav-link {
            color: #C0C0C0;
            padding: 12px 20px;
            margin: 4px 15px;
            border-radius: 8px;
            transition: all 0.3s;
        }

        .nav-link:hover, .nav-link.active {
            background: linear-gradient(90deg, rgba(15, 82, 186, 0.2), transparent);
            color: white;
            border-left: 4px solid var(--primary);
        }

        .nav-link i { margin-right: 15px; width: 20px; text-align: center; }

        .main-content {
            margin-left: 260px;
            padding: 30px;
        }

        .glass-card {
            background: rgba(26, 31, 44, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 20px;
        }

        /* Visibility Contrast Overrides (#212529 replacement) */
        .bg-dark, .table-dark { background-color: var(--slate-grey) !important; color: #fff !important; }
        .form-control.bg-dark, .form-select.bg-dark { background-color: var(--slate-grey-light) !important; border-color: rgba(255,255,255,0.1); }
        .badge.bg-dark { background-color: var(--slate-grey-light) !important; color: #fff !important; }
        .alert-success.bg-dark { background-color: #0f3d24 !important; }
        .alert-danger.bg-dark { background-color: #4b111b !important; }
        .alert-info.bg-dark { background-color: #0c3e4d !important; }

        /* Text Contrast Overrides (#212529 text replacement) */
        .text-muted, .text-secondary, small, .small { color: var(--text-muted) !important; }
        ::placeholder { color: var(--text-muted) !important; opacity: 0.6; }
        .text-dark { color: #111 !important; } /* Ensure text-dark remains dark when on bright highlights like warning/info */
        label, .form-label { color: var(--text-light) !important; opacity: 0.9; }
        .table thead th { color: var(--text-muted) !important; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; }
        .table tbody td { color: var(--text-light) !important; }

        .btn-primary-custom {
            background: var(--primary);
            border: none;
            color: white !important;
            font-weight: 600;
            padding: 8px 20px;
            border-radius: 8px;
            transition: 0.3s;
            text-decoration: none;
            display: inline-block;
        }
        .btn-primary-custom:hover {
            background: #0d46a0;
            transform: translateY(-2px);
            color: white !important;
        }
        .btn-outline-secondary {
            border-color: rgba(255,255,255,0.2);
            color: var(--text-muted);
        }
        .btn-outline-secondary:hover {
            background: rgba(255,255,255,0.05);
            border-color: rgba(255,255,255,0.4);
            color: white;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <a href="#" class="sidebar-brand">AUTO<span>SPHERE</span><br><small style="font-size: 0.8rem; font-weight: normal; color: #888;">ADMIN PANEL</small></a>
        @{
            string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
        }
        <nav class="nav flex-column mt-4">
            <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" asp-area="@(User.IsInRole("Admin") ? "Admin" : "Staff")" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i> Dashboard</a>
            <a class="nav-link @(currentController == "UserManagement" ? "active" : "")" asp-area="Admin" asp-controller="UserManagement" asp-action="Index"><i class="fas fa-users"></i> Manage Users</a>
            <a class="nav-link @(currentController == "StaffManagement" ? "active" : "")" asp-area="Admin" asp-controller="StaffManagement" asp-action="Index"><i class="fas fa-user-tie"></i> Manage Staff</a>
            <a class="nav-link @(currentController == "ServiceManagement" ? "active" : "")" asp-area="Admin" asp-controller="ServiceManagement" asp-action="Index"><i class="fas fa-tools"></i> Services Engine</a>
            <a class="nav-link @(currentController == "BookingManagement" ? "active" : "")" asp-area="Admin" asp-controller="BookingManagement" asp-action="Index"><i class="fas fa-calendar-check"></i> All Bookings</a>
            <a class="nav-link @(currentController == "WalkInBooking" ? "active" : "")" asp-area="Staff" asp-controller="WalkInBooking" asp-action="Index"><i class="fas fa-walking"></i> Walk-in Booking</a>
            <a class="nav-link @(currentController == "InventoryManagement" ? "active" : "")" asp-area="Admin" asp-controller="InventoryManagement" asp-action="Index"><i class="fas fa-boxes"></i> Inventory</a>
            <a class="nav-link @(currentController == "CouponManagement" ? "active" : "")" asp-area="Admin" asp-controller="CouponManagement" asp-action="Index"><i class="fas fa-ticket-alt"></i> Coupons</a>
            <a class="nav-link @(currentController == "BlogManagement" ? "active" : "")" asp-area="Admin" asp-controller="BlogManagement" asp-action="Index"><i class="fas fa-newspaper"></i> Magazine</a>
            <a class="nav-link @(currentController == "ReviewManagement" ? "active" : "")" asp-area="Admin" asp-controller="ReviewManagement" asp-action="Index"><i class="fas fa-star"></i> Reviews</a>
            <a class="nav-link text-danger mt-4" asp-area="" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-globe"></i> View Site</a>
        </nav>
    </div>

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3" style="border-color: rgba(255,255,255,0.1) !important;">
            <h2 class="fw-bold m-0">@ViewData["Title"]</h2>
            <div class="user-profile bg-dark px-3 py-2 rounded-pill border border-secondary" style="border-color: rgba(255,255,255,0.1) !important;">
                <i class="fas fa-user-circle text-primary me-2 fs-5 align-middle"></i>
                <span class="align-middle">@User.Identity?.Name (Admin)</span>
            </div>
        </div>

        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
