@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0"><i class="fas fa-chart-line text-primary me-2"></i> Monthly Overview</h2>
        <div class="text-muted small">Updated: @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-4 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Revenue (@DateTime.Now.ToString("MMM"))</div>
                        <h2 class="fw-bold m-0 mt-1">₹@ViewBag.TotalRevenue.ToString("N0")</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3">
                        <i class="fas fa-indian-rupee-sign text-primary fs-4"></i>
                    </div>
                </div>
                <div class="mt-3">
                    @if (ViewBag.RevenueGrowth >= 0)
                    {
                        <span class="text-success small fw-bold"><i class="fas fa-arrow-up me-1"></i> @ViewBag.RevenueGrowth.ToString("0.0")%</span>
                    }
                    else
                    {
                        <span class="text-danger small fw-bold"><i class="fas fa-arrow-down me-1"></i> @Math.Abs(ViewBag.RevenueGrowth).ToString("0.0")%</span>
                    }
                    <span class="text-muted small ms-1">vs last month</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-4 border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Active Jobs</div>
                        <h2 class="fw-bold m-0 mt-1">@ViewBag.TotalJobs</h2>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded-3">
                        <i class="fas fa-tools text-info fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">Booked for this month</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-4 border-start border-4 border-danger">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Low Stock Alerts</div>
                        <h2 class="fw-bold m-0 mt-1">@ViewBag.LowStockCount</h2>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-3">
                        <i class="fas fa-exclamation-triangle text-danger fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">Items below threshold</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-4 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Staff Online</div>
                        <h2 class="fw-bold m-0 mt-1">Ready</h2>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-3">
                        <i class="fas fa-user-check text-warning fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">System operating normally</div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="glass-card p-4">
                <h5 class="fw-bold mb-4">Revenue Trend (Last 6 Months)</h5>
                <canvas id="revenueTrendChart" height="120"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="glass-card p-4">
                <h5 class="fw-bold mb-4">Job Status Distribution</h5>
                <div style="height: 250px; position: relative;">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 1. Revenue Trend Chart
        fetch('/Admin/Dashboard/GetRevenueTrend')
            .then(res => res.json())
            .then(data => {
                const ctx = document.getElementById('revenueTrendChart').getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: data.map(i => i.month),
                        datasets: [{
                            label: 'Monthly Revenue (₹)',
                            data: data.map(i => i.revenue),
                            borderColor: '#0f52ba',
                            backgroundColor: 'rgba(15, 82, 186, 0.1)',
                            fill: true,
                            tension: 0.4,
                            pointRadius: 5,
                            pointBackgroundColor: '#0f52ba'
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: { beginAtZero: true },
                            x: { grid: { display: false } }
                        },
                        plugins: { legend: { display: false } }
                    }
                });
            });

        // 2. Status Distribution Chart
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        const labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.StatusLabels));
        const chartData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.StatusData));

        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: chartData,
                    backgroundColor: ['#0f52ba', '#ff6b00', '#28a745', '#ffc107', '#dc3545'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { color: '#bbb', usePointStyle: true, font: { size: 11 } } }
                }
            }
        });
    </script>
}
