@model AutoSphere.Models.Staff
@{
    ViewData["Title"] = "Edit Staff";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-card p-4">
            <h4 class="fw-bold mb-4 text-info"><i class="fas fa-user-edit me-2"></i> Edit Staff Details</h4>
            
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label class="form-label text-muted small text-uppercase fw-bold">Display Name</label>
                    <input asp-for="Name" class="form-control bg-dark text-white border-secondary" placeholder="Display name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small text-uppercase fw-bold">Specialization</label>
                    <select asp-for="Specialization" class="form-select bg-dark text-white border-secondary">
                        <option value="General Mechanic">General Mechanic</option>
                        <option value="Electrician">Electrician</option>
                        <option value="Painter">Painter / Denting</option>
                        <option value="Engine Expert">Engine Expert</option>
                        <option value="AC Specialist">AC Specialist</option>
                        <option value="Cleaning / Valeting">Cleaning / Valeting</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small text-uppercase fw-bold">Phone Number</label>
                    <input asp-for="Phone" class="form-control bg-dark text-white border-secondary" required />
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsAvailable">
                        <label class="form-check-label text-light">Available for New Work</label>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-info flex-grow-1">Save Changes</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
