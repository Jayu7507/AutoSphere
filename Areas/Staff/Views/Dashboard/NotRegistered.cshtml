@{
    ViewData["Title"] = "Account Conflict";
}

<div class="container mt-5 pt-5 text-center">
    <div class="glass-card p-5 d-inline-block" style="max-width: 600px;">
        <i class="fas fa-exclamation-triangle text-warning mb-4" style="font-size: 4rem;"></i>
        <h2 class="fw-bold">Registration Required</h2>
        <p class="text-muted mt-3 mb-4">
            Your user account has the <strong class="text-primary">Staff</strong> role, but you are not yet registered in our active staff database. 
            Please contact an administrator to complete your staff profile and begin receiving assignments.
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <a href="/" class="btn btn-outline-light">Back to Home</a>
            <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-danger">Sign Out</a>
        </div>
    </div>
</div>
