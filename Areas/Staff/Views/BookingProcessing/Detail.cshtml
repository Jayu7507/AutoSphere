@model AutoSphere.Models.StaffAssignment
@{
    ViewData["Title"] = "Job Processing";
    var booking = Model.Booking;
}

    @if (booking == null)
    {
        <div class="alert alert-danger bg-dark border-danger text-danger">
            <i class="fas fa-exclamation-triangle me-2"></i> Error: Booking data not found.
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light">Back to Dashboard</a>
    }
    else
    {
    <div class="mb-4">
        <a asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none small">
            <i class="fas fa-arrow-left me-1"></i> Back to assignments
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success bg-dark border-success text-success mb-4">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Info -->
        <div class="col-lg-4">
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom border-secondary pb-2">Client Info</h5>
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="fas fa-user text-primary"></i>
                    </div>
                    <div>
                        <div class="fw-bold">@booking.User?.FullName</div>
                        <div class="small text-muted">@booking.User?.Phone</div>
                    </div>
                </div>
            </div>

            @if (booking.IsDoorstepService)
            {
                <div class="glass-card p-4 mb-4 border border-info border-opacity-25" style="background: rgba(0,255,255,0.05)!important;">
                    <h5 class="fw-bold mb-3 border-bottom border-info border-opacity-25 pb-2 text-info">
                        <i class="fas fa-tools me-2"></i> Doorstep (Field) Service
                    </h5>
                    
                    <div class="mb-4">
                        <span class="text-muted small text-uppercase d-block">Service Address</span>
                        <div class="text-light fw-bold small mb-2">@booking.ServiceAddress</div>
                        <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(booking.ServiceAddress ?? "")" target="_blank" class="btn btn-sm btn-outline-info w-100">
                            <i class="fas fa-map-marked-alt me-1"></i> Navigate to Location
                        </a>
                    </div>
                </div>
            }

            @if (booking.IsPickupDelivery)
            {
                <div class="glass-card p-4 mb-4 border border-primary border-opacity-25" style="background: rgba(255,107,0,0.05)!important;">
                    <h5 class="fw-bold mb-3 border-bottom border-primary border-opacity-25 pb-2 text-primary">
                        <i class="fas fa-shipping-fast me-2"></i> Logistics Panel
                    </h5>
                    
                    <div class="mb-4">
                        <span class="text-muted small text-uppercase d-block">Pickup Address</span>
                        <div class="text-light fw-bold small mb-2">@booking.PickupAddress</div>
                        <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(booking.PickupAddress ?? "")" target="_blank" class="btn btn-sm btn-outline-primary w-100">
                            <i class="fas fa-map-marked-alt me-1"></i> Open Pickup Map
                        </a>
                    </div>

                    <div>
                        <span class="text-muted small text-uppercase d-block">Delivery Address</span>
                        <div class="text-light fw-bold small mb-2">@booking.DeliveryAddress</div>
                        <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(booking.DeliveryAddress ?? "")" target="_blank" class="btn btn-sm btn-outline-secondary w-100">
                            <i class="fas fa-route me-1"></i> Open Delivery Map
                        </a>
                    </div>
                </div>
            }

            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom border-secondary pb-2">Vehicle Info</h5>
                <div class="mb-2">
                    <span class="text-muted small text-uppercase d-block">Brand & Model</span>
                    <span class="fw-bold text-light">@booking.Vehicle?.Brand @booking.Vehicle?.ModelName</span>
                </div>
                <div>
                    <span class="text-muted small text-uppercase d-block">License Plate</span>
                    <span class="badge bg-dark border border-secondary text-light px-3 py-2 fw-bold" style="letter-spacing: 2px;">@booking.Vehicle?.LicensePlate</span>
                </div>
            </div>

            <div class="glass-card p-4">
                <h5 class="fw-bold mb-3 border-bottom border-secondary pb-2">Requested Services</h5>
                <ul class="list-unstyled mb-0">
                    @foreach (var s in booking.BookingDetails ?? Enumerable.Empty<AutoSphere.Models.BookingDetail>())
                    {
                        <li class="mb-2 d-flex align-items-start">
                            <i class="fas fa-check-circle text-success mt-1 me-2"></i>
                            <div>
                                <div class="text-light fw-bold small">@s.Service?.Name</div>
                                <div class="x-small text-muted">@s.Service?.Description</div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Right Column: Actions -->
        <div class="col-lg-8">
            <div class="glass-card p-4">
                <h4 class="fw-bold mb-4">
                    <i class="fas fa-cogs me-2 text-primary"></i> Update Job Progress
                </h4>

                <form asp-action="UpdateProgress" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase fw-bold">Current Status</label>
                            <select name="status" class="form-select bg-dark text-white border-secondary">
                                <option value="Confirmed" selected="@(booking.Status == "Confirmed" ? "selected" : null)">Confirmed / Assigned</option>
                                <option value="In Progress" selected="@(booking.Status == "In Progress" ? "selected" : null)">In Progress</option>
                                <option value="WaitingForParts" selected="@(booking.Status == "WaitingForParts" ? "selected" : null)">Awaiting Parts</option>
                                <option value="Completed" selected="@(booking.Status == "Completed" ? "selected" : null)">Completed</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase fw-bold">Additional Cost (₹)</label>
                            <input type="number" step="0.01" name="additionalCost" value="@Model.AdditionalCost" class="form-control bg-dark text-white border-secondary" placeholder="0.00" />
                            <small class="text-muted">Labor or extra parts cost for this assignment.</small>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small text-uppercase fw-bold">Add Parts from Inventory</label>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <select name="partId" class="form-select bg-dark text-white border-secondary">
                                    <option value="">-- Select a Part to Add --</option>
                                    @foreach (var part in ViewBag.Parts as List<AutoSphere.Models.Part> ?? new List<AutoSphere.Models.Part>())
                                    {
                                        <option value="@part.Id">@part.Name (₹@part.Price) - Stock: @part.StockQuantity</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-muted">Qty</span>
                                    <input type="number" name="partQty" value="1" min="1" class="form-control bg-dark text-white border-secondary" />
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 p-2 bg-dark rounded border border-secondary border-opacity-25 small">
                            <span class="text-muted fw-bold">Current Parts:</span> 
                            <span class="text-light italic">@(string.IsNullOrEmpty(Model.PartsUsed) ? "None" : Model.PartsUsed)</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small text-uppercase fw-bold">Service & Inspection Notes</label>
                        <textarea name="serviceNotes" rows="4" class="form-control bg-dark text-white border-secondary" placeholder="Describe what you did or any issues found...">@Model.ServiceNotes</textarea>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-3 bg-dark rounded border border-secondary bg-opacity-25 mt-5">
                        <div class="small text-muted">
                            <i class="fas fa-info-circle me-1"></i> Saving updates will notify the admin and update the final bill.
                        </div>
                        <button type="submit" class="btn btn-primary-custom px-5 py-2">
                            Update Job <i class="fas fa-sync-alt ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
