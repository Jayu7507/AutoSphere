@{
    ViewData["Title"] = "Walk-in Customer";
    Layout = User.IsInRole("Admin") ? "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml" : "_StaffLayout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-card p-5 text-center">
            <div class="mb-4">
                <div class="bg-primary bg-opacity-10 d-inline-block p-4 rounded-circle mb-3">
                    <i class="fas fa-walking fa-3x text-primary"></i>
                </div>
                <h2 class="fw-bold">Walk-in Booking</h2>
                <p class="text-muted">Enter the customer's phone number to start the process.</p>
            </div>

            <form asp-action="Search" method="get">
                <div class="input-group mb-4 shadow-sm">
                    <span class="input-group-text bg-dark border-secondary text-muted px-4" style="border-radius: 15px 0 0 15px;">
                        <i class="fas fa-phone"></i>
                    </span>
                    <input type="text" name="phone" class="form-control bg-dark text-white border-secondary py-3" 
                           placeholder="9876543210" required style="border-radius: 0 15px 15px 0;" />
                </div>
                <button type="submit" class="btn btn-primary-custom w-100 py-3 rounded-pill fw-bold fs-5 mb-3">
                    FIND CUSTOMER <i class="fas fa-search ms-2"></i>
                </button>
                <a asp-area="@(User.IsInRole("Admin") ? "Admin" : "Staff")" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary w-100 py-2 rounded-pill small">
                    <i class="fas fa-arrow-left me-1"></i> Cancel & Back to Dashboard
                </a>
            </form>

            <div class="mt-4 pt-4 border-top border-secondary border-opacity-10 text-start">
                <h6 class="text-muted small fw-bold text-uppercase mb-3">Recent Walk-ins</h6>
                <div class="small text-muted italic">No recent walk-in history available for this terminal.</div>
            </div>
        </div>
    </div>
</div>
