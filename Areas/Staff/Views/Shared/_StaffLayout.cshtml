<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staff Hub | AutoSphere</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0F52BA;
            --secondary: #FF6B00;
            --dark-bg: #0B0F19;
            --sidebar-bg: #0d1117;
            --text-light: #F8F9FA;
            --slate-grey: #2E3440;
            --slate-grey-light: #3B4252;
            --text-muted: #94A3B8;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-light);
            font-family: 'Outfit', sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
        }

        /* Sidebar Styling */
        .sidebar {
            width: 280px;
            height: 100vh;
            background: var(--sidebar-bg);
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            position: fixed;
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            padding: 30px 20px;
            z-index: 1000;
        }

        .sidebar-brand {
            font-size: 1.5rem;
            font-weight: 800;
            color: white;
            text-decoration: none;
            margin-bottom: 50px;
            letter-spacing: 1px;
        }

        .sidebar-brand span { color: var(--secondary); }

        .nav-column {
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex-grow: 1;
        }

        .nav-link-staff {
            color: var(--text-muted);
            text-decoration: none;
            padding: 12px 20px;
            border-radius: 10px;
            transition: 0.3s;
            display: flex;
            align-items: center;
            font-weight: 600;
        }

        .nav-link-staff:hover {
            color: white;
            background: rgba(255, 255, 255, 0.05);
        }

        .nav-link-staff.active {
            color: white;
            background: var(--primary);
            box-shadow: 0 4px 15px rgba(15, 82, 186, 0.3);
        }

        .nav-link-staff i { width: 30px; }

        /* Main Content */
        .main-wrapper {
            margin-left: 280px;
            flex-grow: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .top-header {
            height: 80px;
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .content-area {
            padding: 40px;
        }

        .glass-card {
            background: rgba(26, 31, 44, 0.4);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
        }

        .sidebar-footer {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 20px;
        }

        /* Contrast Overrides for Content */
        .table-dark { background: transparent !important; }
        .text-muted { color: #94A3B8 !important; }
        .btn-primary-custom {
            background: var(--primary);
            border: none;
            color: white;
            font-weight: 600;
            padding: 8px 20px;
            border-radius: 8px;
            transition: 0.3s;
        }
        .btn-primary-custom:hover {
            background: #0d46a0;
            transform: translateY(-2px);
        }

        @@media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); transition: 0.3s; }
            .main-wrapper { margin-left: 0; }
            .sidebar.active { transform: translateX(0); }
        }
    </style>
</head>
<body>
    @{
        string currentStaffController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    }

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            AUTO<span>SPHERE</span>
        </a>

        <div class="nav-column">
            <a class="nav-link-staff @(currentStaffController == "Dashboard" ? "active" : "")" asp-area="Staff" asp-controller="Dashboard" asp-action="Index">
                <i class="fas fa-th-large"></i> Dashboard
            </a>
            <a class="nav-link-staff @(currentStaffController == "BookingProcessing" ? "active" : "")" asp-area="Staff" asp-controller="BookingProcessing" asp-action="Index">
                <i class="fas fa-tools"></i> Service Hub
            </a>
            <a class="nav-link-staff @(currentStaffController == "WalkInBooking" ? "active" : "")" asp-area="Staff" asp-controller="WalkInBooking" asp-action="Index">
                <i class="fas fa-walking"></i> Walk-in Booking
            </a>
        </div>

        <div class="sidebar-footer">
            <a class="nav-link-staff text-danger" asp-area="" asp-controller="Account" asp-action="Logout">
                <i class="fas fa-sign-out-alt"></i> Sign Out
            </a>
        </div>
    </div>

    <!-- Main Wrapper -->
    <div class="main-wrapper">
        <div class="top-header">
            <div class="d-flex align-items-center">
                <button class="btn btn-link text-white d-lg-none me-3" onclick="document.getElementById('sidebar').classList.toggle('active')">
                    <i class="fas fa-bars"></i>
                </button>
                <h5 class="fw-bold m-0"><span class="text-muted fw-normal small">Panel / </span> @ViewData["Title"]</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-md-block">
                    <div class="fw-bold small">@User.Identity?.Name</div>
                    <div class="text-primary x-small fw-bold">SERVICE AGENT</div>
                </div>
                <div style="width: 40px; height: 40px; background: var(--primary); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-user-gear text-white"></i>
                </div>
            </div>
        </div>

        <div class="content-area">
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
