@model AutoSphere.Models.Booking
@{
    ViewData["Title"] = "Track Service Progress";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h6 class="text-secondary text-uppercase fw-bold letter-spacing-2">Telemetry & Service Pulse</h6>
        <h1 class="display-5 fw-bold text-white mb-2">Live Service Tracking</h1>
        <p class="text-muted">Real-time status tracking for workshop and doorstep operations</p>
    </div>

    <!-- Search Card -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-8 col-lg-6">
            <div class="glass-card p-4">
                <form asp-controller="Booking" asp-action="Track" method="get">
                    <label class="form-label text-muted small fw-bold">Enter Booking Reference ID</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" name="reference" value="@(Model?.BookingReference ?? Context.Request.Query["reference"])" class="form-control bg-dark text-white border-secondary fs-5" placeholder="e.g. BKG12345" required />
                        <button type="submit" class="btn btn-secondary-custom px-4 fw-bold">TRACK</button>
                    </div>
                </form>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger bg-dark border-0 mt-3 mb-0 small">
                        <i class="fas fa-exclamation-circle me-1 text-danger"></i> @ViewBag.Error
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <!-- Status Tracker Header Card -->
                <div class="glass-card p-4 p-md-5 mb-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center pb-4 mb-4 border-bottom border-secondary border-opacity-25 gap-3">
                        <div>
                            <span class="badge bg-secondary px-3 py-1 mb-2">REF: @Model.BookingReference</span>
                            <h3 class="fw-bold text-white mb-0">@Model.Vehicle?.Brand @Model.Vehicle?.ModelName</h3>
                            <small class="text-muted"><i class="fas fa-id-card me-1"></i> Plate: @Model.Vehicle?.LicensePlate</small>
                        </div>
                        <div class="text-md-end">
                            <small class="text-muted d-block">Scheduled Date</small>
                            <span class="fs-5 fw-bold text-white">@Model.ScheduledDate.ToString("dd MMMM yyyy")</span>
                        </div>
                    </div>

                    <!-- Visual Step Progress Bar -->
                    @{
                        var statuses = new[] { "Pending", "Confirmed", "InProgress", "Completed" };
                        int currentIndex = Array.IndexOf(statuses, Model.Status);
                        if (currentIndex == -1 && Model.Status == "WaitingForParts") currentIndex = 2;
                    }
                    <div class="py-4">
                        <div class="row text-center position-relative">
                            <div class="col-3">
                                <div class="p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-2 @(currentIndex >= 0 ? "bg-primary text-white" : "bg-dark text-muted")" style="width: 50px; height: 50px;">
                                    <i class="fas fa-receipt"></i>
                                </div>
                                <div class="small fw-bold @(currentIndex >= 0 ? "text-white" : "text-muted")">Pending</div>
                            </div>
                            <div class="col-3">
                                <div class="p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-2 @(currentIndex >= 1 ? "bg-primary text-white" : "bg-dark text-muted")" style="width: 50px; height: 50px;">
                                    <i class="fas fa-check"></i>
                                </div>
                                <div class="small fw-bold @(currentIndex >= 1 ? "text-white" : "text-muted")">Confirmed</div>
                            </div>
                            <div class="col-3">
                                <div class="p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-2 @(currentIndex >= 2 ? "bg-secondary text-white" : "bg-dark text-muted")" style="width: 50px; height: 50px;">
                                    <i class="fas fa-cogs"></i>
                                </div>
                                <div class="small fw-bold @(currentIndex >= 2 ? "text-secondary" : "text-muted")">
                                    @(Model.Status == "WaitingForParts" ? "Waiting For Parts" : "In Progress")
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-2 @(currentIndex >= 3 ? "bg-success text-white" : "bg-dark text-muted")" style="width: 50px; height: 50px;">
                                    <i class="fas fa-flag-checkered"></i>
                                </div>
                                <div class="small fw-bold @(currentIndex >= 3 ? "text-success" : "text-muted")">Completed</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Booking Details & Breakdown -->
                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="glass-card p-4 h-100">
                            <h5 class="fw-bold text-white mb-3"><i class="fas fa-clipboard-list text-primary me-2"></i> Included Services</h5>
                            <div class="list-group list-group-flush bg-transparent">
                                @foreach (var item in Model.BookingDetails)
                                {
                                    <div class="list-group-item bg-transparent text-white border-secondary border-opacity-10 d-flex justify-content-between align-items-center px-0 py-3">
                                        <div>
                                            <h6 class="mb-0 fw-bold">@item.Service?.Name</h6>
                                            <small class="text-muted">@item.Service?.Description</small>
                                        </div>
                                        <span class="fw-bold text-secondary">₹@item.PriceAtBooking.ToString("N0")</span>
                                    </div>
                                }
                            </div>

                            @if (Model.IsDoorstepService)
                            {
                                <div class="mt-4 p-3 rounded-3 bg-secondary bg-opacity-10 border border-secondary border-opacity-25">
                                    <h6 class="text-secondary fw-bold mb-1"><i class="fas fa-home me-2"></i> Doorstep Concierge Service</h6>
                                    <small class="text-white-50">Service Address: @Model.ServiceAddress</small>
                                </div>
                            }
                            @if (Model.IsPickupDelivery)
                            {
                                <div class="mt-3 p-3 rounded-3 bg-primary bg-opacity-10 border border-primary border-opacity-25">
                                    <h6 class="text-primary fw-bold mb-1"><i class="fas fa-truck me-2"></i> Valet Pickup & Delivery</h6>
                                    <small class="text-white-50">Pickup: @Model.PickupAddress | Drop: @Model.DeliveryAddress</small>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="glass-card p-4 h-100 d-flex flex-column">
                            <h5 class="fw-bold text-white mb-3"><i class="fas fa-receipt text-secondary me-2"></i> Billing Summary</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Services Total</span>
                                <span class="text-white">₹@Model.TotalAmount.ToString("N2")</span>
                            </div>
                            @if (Model.DiscountAmount > 0)
                            {
                                <div class="d-flex justify-content-between mb-2 text-success">
                                    <span>Coupon Discount</span>
                                    <span>-₹@Model.DiscountAmount.ToString("N2")</span>
                                </div>
                            }
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">GST (18%)</span>
                                <span class="text-white">₹@((Model.FinalAmount * 0.18m).ToString("N2"))</span>
                            </div>
                            <div class="d-flex justify-content-between py-3 border-top border-secondary border-opacity-25 mb-4">
                                <span class="fs-5 fw-bold text-white">Grand Total</span>
                                <span class="fs-4 fw-bold text-secondary">₹@((Model.FinalAmount * 1.18m).ToString("N2"))</span>
                            </div>

                            @if (Model.StaffAssignments.Any())
                            {
                                <div class="mt-auto p-3 rounded-3 bg-dark">
                                    <small class="text-muted text-uppercase fw-bold d-block mb-2">Assigned Specialist</small>
                                    @foreach (var assign in Model.StaffAssignments)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fas fa-user-cog text-primary"></i>
                                            <span class="text-white small fw-bold">@assign.Staff?.Name</span>
                                            <span class="badge bg-secondary ms-auto small">@(assign.Staff?.Specialization ?? "Technician")</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
