@model AutoSphere.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="glass-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle bg-secondary bg-opacity-10 text-secondary mb-3">
                        <i class="fas fa-user-plus fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-white">Join AutoSphere</h3>
                    <p class="text-muted small">Access smart maintenance, tracking, and priority booking</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger bg-dark border-0 py-2 small mb-3">
                        <div asp-validation-summary="All" class="text-danger mb-0"></div>
                    </div>
                }

                <form asp-controller="Account" asp-action="Register" method="post">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label text-muted small fw-bold">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-user"></i></span>
                            <input asp-for="FullName" class="form-control bg-dark text-white border-secondary" placeholder="John Doe" required autofocus />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label text-muted small fw-bold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control bg-dark text-white border-secondary" placeholder="user@example.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label text-muted small fw-bold">Mobile Phone</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-phone"></i></span>
                                <input asp-for="Phone" class="form-control bg-dark text-white border-secondary" placeholder="+91 9876543210" required />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label text-muted small fw-bold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-lock"></i></span>
                                <input asp-for="Password" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label text-muted small fw-bold">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-shield-alt"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-secondary-custom w-100 py-3 fw-bold rounded-pill shadow-sm">
                        CREATE ACCOUNT <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <p class="text-muted small mb-0">
                        Already have an account? 
                        <a asp-controller="Account" asp-action="Login" class="text-secondary fw-bold text-decoration-none">Sign In</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
