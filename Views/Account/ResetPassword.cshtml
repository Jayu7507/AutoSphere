@model AutoSphere.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "New Password";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="glass-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle bg-success bg-opacity-10 text-success mb-3">
                        <i class="fas fa-lock-open fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-white">Create New Password</h3>
                    <p class="text-muted small">Enter the 6-digit OTP sent to your email and set your new password</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger bg-dark border-0 py-2 small mb-3">
                        <div asp-validation-summary="All" class="text-danger mb-0"></div>
                    </div>
                }

                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-muted small fw-bold">Email Address</label>
                        <input asp-for="Email" class="form-control bg-dark text-white border-secondary" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="OTP" class="form-label text-muted small fw-bold">6-Digit OTP</label>
                        <input asp-for="OTP" class="form-control bg-dark text-white border-secondary" maxlength="6" placeholder="123456" required autofocus />
                        <span asp-validation-for="OTP" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label text-muted small fw-bold">New Password</label>
                        <input asp-for="NewPassword" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" required />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label text-muted small fw-bold">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-secondary-custom w-100 py-3 fw-bold rounded-pill shadow-sm">
                        UPDATE PASSWORD <i class="fas fa-check ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
