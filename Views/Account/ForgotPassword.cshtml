@model AutoSphere.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="glass-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle bg-warning bg-opacity-10 text-warning mb-3">
                        <i class="fas fa-key fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-white">Reset Password</h3>
                    <p class="text-muted small">Enter your email address to receive a verification OTP</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger bg-dark border-0 py-2 small mb-3">
                        <div asp-validation-summary="All" class="text-danger mb-0"></div>
                    </div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label text-muted small fw-bold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-envelope"></i></span>
                            <input asp-for="Email" class="form-control bg-dark text-white border-secondary" placeholder="user@example.com" required autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-secondary-custom w-100 py-3 fw-bold rounded-pill shadow-sm">
                        SEND RESET CODE <i class="fas fa-paper-plane ms-2"></i>
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-action="Login" class="text-muted small text-decoration-none">
                        <i class="fas fa-arrow-left me-1"></i> Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
