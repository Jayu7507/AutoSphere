@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 my-5 text-center">
    <div class="glass-card p-5 mx-auto" style="max-width: 550px;">
        <div class="d-inline-flex p-4 rounded-circle bg-danger bg-opacity-10 text-danger mb-4">
            <i class="fas fa-shield-alt fa-3x"></i>
        </div>
        <h2 class="text-white fw-bold mb-3">Access Denied</h2>
        <p class="text-muted mb-4">You do not have the necessary security credentials or role permissions to access this page.</p>

        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-custom px-4 py-2">
                <i class="fas fa-home me-2"></i> Home
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom px-4 py-2">
                <i class="fas fa-sign-in-alt me-2"></i> Sign In With Another Account
            </a>
        </div>
    </div>
</div>
