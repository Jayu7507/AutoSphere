@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 my-5 text-center">
    <div class="glass-card p-5 mx-auto" style="max-width: 600px;">
        <i class="fas fa-exclamation-triangle text-warning display-3 mb-4"></i>
        <h2 class="text-white fw-bold mb-3">Something Went Wrong</h2>
        <p class="text-muted mb-4">An error occurred while processing your request. Please try again later or return to home.</p>

        @if (Model?.ShowRequestId == true)
        {
            <div class="p-3 bg-dark rounded-3 mb-4">
                <small class="text-muted d-block">Diagnostic Trace Identifier</small>
                <code class="text-info">@Model.RequestId</code>
            </div>
        }

        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
                <i class="fas fa-home me-2"></i> Return to Safety
            </a>
        </div>
    </div>
</div>
