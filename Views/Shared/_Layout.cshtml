<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoSphere | Premium Vehicle Services</title>
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <style>
        :root {
            --primary: #0F52BA;
            --primary-hover: #0d46a0;
            --secondary: #FF6B00;
            --secondary-hover: #e05e00;
            --dark-bg: #0B0F19;
            --light-bg: #1A1F2C;
            --text-light: #F8F9FA;
            --slate-grey: #2E3440;
            --slate-grey-light: #3B4252;
            --text-muted: #94A3B8;

            --bs-body-color: var(--text-light);
            --bs-body-bg: var(--dark-bg);
            --bs-secondary-color: var(--text-muted);
            --bs-tertiary-color: var(--text-muted);
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-light);
            font-family: 'Outfit', sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background: rgba(11, 15, 25, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            position: sticky;
            top: 0;
            z-index: 1050;
            transition: all 0.3s ease;
        }

        .navbar-brand-custom {
            font-weight: 800;
            font-size: 1.6rem;
            letter-spacing: 1.5px;
            color: #ffffff;
            text-decoration: none;
        }

        .navbar-brand-custom span {
            color: var(--secondary);
        }

        .nav-link-custom {
            color: rgba(255, 255, 255, 0.8) !important;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 8px 16px !important;
            transition: all 0.25s ease;
            border-radius: 8px;
        }

        .nav-link-custom:hover, .nav-link-custom.active {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.06);
        }

        .glass-card {
            background: rgba(26, 31, 44, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .btn-primary-custom {
            background: var(--primary);
            border: none;
            color: white !important;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 50px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary-custom:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(15, 82, 186, 0.4);
            color: white !important;
        }

        .btn-secondary-custom {
            background: var(--secondary);
            border: none;
            color: white !important;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 50px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-secondary-custom:hover {
            background: var(--secondary-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 107, 0, 0.4);
            color: white !important;
        }

        .btn-outline-custom {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--text-light) !important;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 50px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-outline-custom:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.4);
            color: white !important;
        }

        /* Visibility Contrast Overrides */
        .bg-dark, .table-dark { background-color: var(--slate-grey) !important; color: #fff !important; }
        .form-control.bg-dark, .form-select.bg-dark { background-color: var(--slate-grey-light) !important; border-color: rgba(255,255,255,0.1); color: #fff !important; }
        .badge.bg-dark { background-color: var(--slate-grey-light) !important; color: #fff !important; }
        .text-muted, .text-secondary { color: var(--text-muted) !important; }
        ::placeholder { color: var(--text-muted) !important; opacity: 0.6; }

        .footer {
            background: #080c14;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            margin-top: auto;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom py-3">
            <div class="container">
                <a class="navbar-brand-custom" asp-area="" asp-controller="Home" asp-action="Index">
                    AUTO<span>SPHERE</span>
                </a>
                <button class="navbar-toggler text-white border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars fs-4"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto ms-lg-4 mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Service" asp-action="Index">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Booking" asp-action="Book">Book Service</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Booking" asp-action="Track">Track Status</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Blog" asp-action="Index">Articles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-custom dropdown-toggle px-3 py-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-1 text-secondary"></i> @(User.Identity.Name ?? "Account")
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg" style="background-color: var(--light-bg); border-color: rgba(255,255,255,0.1);">
                                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="User" asp-action="Dashboard"><i class="fas fa-tachometer-alt me-2 text-primary"></i> My Dashboard</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-shield-alt me-2 text-warning"></i> Admin Portal</a></li>
                                    }
                                    @if (User.IsInRole("Staff") || User.IsInRole("Mechanic"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-area="Staff" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-tools me-2 text-info"></i> Staff Portal</a></li>
                                    }
                                    <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                                    <li><a class="dropdown-item py-2 text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i> Logout</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-custom py-2 px-4" asp-area="" asp-controller="Account" asp-action="Login">Sign In</a>
                            <a class="btn btn-secondary-custom py-2 px-4 shadow-sm" asp-area="" asp-controller="Account" asp-action="Register">Join Now</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer py-5 mt-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-white mb-3">AUTO<span style="color: var(--secondary);">SPHERE</span></h5>
                    <p class="text-muted small">Next-generation connected automotive maintenance platform. Intelligent scheduling, real-time telemetry tracking, and certified master technicians.</p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="text-muted fs-5"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-muted fs-5"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-muted fs-5"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-muted fs-5"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Explore</h6>
                    <ul class="list-unstyled text-muted small d-flex flex-column gap-2 mb-0">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">Home</a></li>
                        <li><a asp-area="" asp-controller="Service" asp-action="Index" class="text-muted text-decoration-none">Services</a></li>
                        <li><a asp-area="" asp-controller="Booking" asp-action="Track" class="text-muted text-decoration-none">Track Status</a></li>
                        <li><a asp-area="" asp-controller="Blog" asp-action="Index" class="text-muted text-decoration-none">Blog & Articles</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Portals</h6>
                    <ul class="list-unstyled text-muted small d-flex flex-column gap-2 mb-0">
                        <li><a asp-area="" asp-controller="User" asp-action="Dashboard" class="text-muted text-decoration-none">User Hub</a></li>
                        <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none">Admin Suite</a></li>
                        <li><a asp-area="Staff" asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none">Staff Desk</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Newsletter</h6>
                    <p class="text-muted small">Subscribe to our technical updates and exclusive maintenance privileges.</p>
                    <form id="footerNewsletterForm" onsubmit="handleFooterSubscribe(event)">
                        <div class="input-group">
                            <input type="email" id="footerSubscriberEmail" class="form-control bg-dark border-secondary text-white" placeholder="Enter your email" aria-label="Newsletter email" required>
                            <button class="btn btn-primary-custom" id="footerSubscribeBtn" type="submit">Join</button>
                        </div>
                        <div id="footerSubscribeMsg" class="small mt-2 d-none"></div>
                    </form>
                </div>
            </div>
            <div class="border-top border-secondary border-opacity-10 pt-4 text-center">
                <small class="text-muted">&copy; @DateTime.Now.Year AutoSphere. All rights reserved. Precision vehicle engineering.</small>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function handleFooterSubscribe(e) {
            e.preventDefault();
            const emailInput = document.getElementById('footerSubscriberEmail');
            const msg = document.getElementById('footerSubscribeMsg');
            const btn = document.getElementById('footerSubscribeBtn');
            if (!emailInput || !emailInput.value) return;

            btn.disabled = true;
            fetch('/Home/Subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'email=' + encodeURIComponent(emailInput.value)
            })
            .then(r => r.json())
            .then(d => {
                msg.classList.remove('d-none', 'text-success', 'text-danger');
                msg.classList.add(d.success ? 'text-success' : 'text-danger');
                msg.innerText = d.message;
                if (d.success) emailInput.value = '';
            })
            .catch(() => {
                msg.classList.remove('d-none', 'text-success');
                msg.classList.add('text-danger');
                msg.innerText = 'Unable to subscribe. Try again.';
            })
            .finally(() => {
                btn.disabled = false;
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
